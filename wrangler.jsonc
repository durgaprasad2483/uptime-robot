{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // every minute: checks · daily 00:00 UTC: prune old stats
  "triggers": { "crons": ["* * * * *", "0 0 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "pulse", "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create", "migrations_dir": "migrations" }
  ],
  "vars": {
    "TIMEZONE": "Asia/Kolkata",
    "RETENTION_DAYS": "90",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
